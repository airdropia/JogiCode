{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JogiCode",
  "version": "1.0.16",
  "identifier": "com.jogicode.app",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "JogiCode",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "webviewOptions": {
          "additionalBrowserArgs": [
            "--memory-pressure-off",
            "--disable-gpu-shader-disk-cache",
            "--disable-features=CalculateNativeWinOcclusion",
            "--js-flags=--max-old-space-size=256"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["binaries/**/*"],
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
